# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kiip
POSTGRES_USER=kiip
POSTGRES_PASSWORD=kiip_secret
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?connection_limit=50&pool_timeout=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Backend
BACKEND_PORT=3000

# Frontend
VITE_API_URL=http://localhost:3000

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=30

# Redirect - buffer de access logs e contador de cliques
# Quantidade de logs no buffer que dispara um flush imediato (além do timer periódico)
ACCESS_LOG_THRESHOLD=100
# Intervalo do flush periódico do buffer de access logs, em milissegundos
ACCESS_LOG_FLUSH_INTERVAL_MS=5000
# Tamanho máximo de cada lote lido do buffer por vez durante o flush
ACCESS_LOG_FLUSH_BATCH_SIZE=1000
# TTL do contador de cliques pendente no Redis (clicks:{linkId}), em segundos
CLICK_COUNT_TTL_SECONDS=3600

# Links - buffer de criação e cache local em memória (L1)
# Quantidade de links no buffer que dispara um flush imediato (além do timer periódico)
LINK_BUFFER_THRESHOLD=20
# Intervalo do flush periódico do buffer de links, em milissegundos
LINK_FLUSH_INTERVAL_MS=2000
# TTL do cache L1 em memória do processo, em milissegundos
LOCAL_CACHE_TTL_MS=2000
# Número máximo de links mantidos no cache L1 (LRU) por instância
LOCAL_CACHE_MAX_SIZE=1000